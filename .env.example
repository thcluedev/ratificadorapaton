# SQLite en local (sin Docker). Con Docker ver .env.docker.example (file:/data/dev.db).
# Postgres (Vercel / docker-compose.postgres.yml):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?schema=public"
DATABASE_URL="file:./dev.db"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET="cambialo-por-un-secreto-largo-en-produccion"

# En Vercel, cuando pases a Blob, no hace falta tocar código:
# BLOB_READ_WRITE_TOKEN=""
