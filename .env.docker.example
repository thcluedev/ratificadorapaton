# Copiar a .env para docker compose:  cp .env.docker.example .env

# --- App ---
APP_PORT=3000
SESSION_SECRET=docker-dev-cambiar-en-produccion-minimo-32-chars

# SQLite dentro del contenedor (volumen paton_sqlite → /data)
DATABASE_URL=file:/data/dev.db

# Primera vez: usuarios + catálogo (PIN 1234)
